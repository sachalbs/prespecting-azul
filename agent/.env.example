# ── Azul agent — environment ───────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`. All secrets live here.

# Runtime
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ── Database ────────────────────────────────────────────────────────────────
# Production target: Postgres 16 + pgvector. Example:
#   DATABASE_URL=postgresql+psycopg://azul:azul@localhost:5432/azul
# Zero-infra dev/demo fallback (vector column degrades to JSON, skills deferred):
DATABASE_URL=sqlite:///azul.db

# ── Adapter selection (stub today → live once keys land) ────────────────────
# stub | waterfall
SOURCING_PROVIDER=stub
# stub | holo3
RESEARCH_ENGINE=stub
# stub | openai_compat
WRITER_PROVIDER=stub
# stub | unipile
CHANNEL=stub

# ── Sourcing waterfall (find + verify before any send) ──────────────────────
PROSPEO_API_KEY=
HUNTER_API_KEY=
DROPCONTACT_API_KEY=

# ── Research engine (Holo3, behind ResearchEngine) ──────────────────────────
HOLO3_API_KEY=
HOLO3_BASE_URL=https://api.holo3.ai

# ── Writer (GLM-5.1 / DeepSeek V4 — OpenAI-compatible, behind Writer) ───────
# Set base URL + model to whichever provider you choose; one key drives it.
WRITER_API_KEY=
WRITER_BASE_URL=
WRITER_MODEL=
WRITER_TEMPERATURE=0.7

# ── Connector (Unipile — send from the real mailbox + reply webhooks) ───────
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_ACCOUNT_ID=
UNIPILE_WEBHOOK_SECRET=

# ── Deliverability: pace the sends, never spray ─────────────────────────────
SEND_MIN_DELAY_SECONDS=45
SEND_MAX_DELAY_SECONDS=180
DAILY_SEND_CAP=25

# ── Flywheel (later) — skills embedding dimension ───────────────────────────
EMBEDDING_DIM=1024
