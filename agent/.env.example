# ── Azul agent — environment ───────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`. All secrets live here.

# Runtime
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ── Database ────────────────────────────────────────────────────────────────
# Prod: Postgres 16 + pgvector. Dev/demo fallback:
DATABASE_URL=sqlite:///azul.db

# ── Adapter selection (stub → live) ─────────────────────────────────────────
# stub | finder (in-house: permutations + MX/SMTP — the real-run choice)
#      | prospeo | waterfall (paid APIs, kept behind the same interface)
SOURCING_PROVIDER=stub
# stub | dossier (Prospeo dossier only, no browser — v0) | holo3 (deep, browser)
RESEARCH_ENGINE=stub
# stub | openai_compat
WRITER_PROVIDER=stub
# stub | graph
CHANNEL=stub

# ── Discovery (ICP brief -> leads). Provider TBD (Brave/Serper/Bing). ───────
# stub | websearch
DISCOVERY_PROVIDER=stub
SEARCH_API_KEY=
SEARCH_API_URL=

# ── Sourcing (Prospeo enrich = find + verify + dossier) ─────────────────────
PROSPEO_API_KEY=
HUNTER_API_KEY=
DROPCONTACT_API_KEY=

# In-house verifier — SMTP RCPT handshake + catch-all probe.
# Needs outbound port 25 (blocked on most home/cloud networks; open on the VPS).
# false = syntax + MX only (verdicts cap at UNKNOWN; such sends are flagged, not blocked).
VERIFY_SMTP=false

# ── Research — Holo3 computer-use (drives a headless browser) ───────────────
HAI_API_KEY=
HOLO_BASE_URL=https://api.hcompany.ai/v1
HOLO_MODEL=holo3-1-35b-a3b
HOLO_MAX_STEPS=25
HOLO_TIMEOUT_S=120
HOLO_HEADLESS=true
# Playwright storage_state JSON with a logged-in LinkedIn session (you create it):
#   azul linkedin-login   ->  writes this file after you log in once
LINKEDIN_STORAGE_STATE=.linkedin_state.json

# ── Writer (OpenAI-compatible: GLM-5.1 / DeepSeek V4 / Mistral) ──────────────
# Example (Mistral — EU, supports JSON mode; also powers chat NL intent):
#   WRITER_PROVIDER=openai_compat
#   WRITER_BASE_URL=https://api.mistral.ai/v1
#   WRITER_MODEL=mistral-large-latest
# Example (Gemini Flash — OpenAI-compatible endpoint):
#   WRITER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   WRITER_MODEL=gemini-2.0-flash
WRITER_API_KEY=
WRITER_BASE_URL=
WRITER_MODEL=
WRITER_TEMPERATURE=0.7
WRITER_PLAYBOOK_PATH=AZUL_COLD_OUTREACH_PLAYBOOK.md

# ── Operator chat channel (manage Azul like an employee) ────────────────────
# Telegram: official, free, zero-friction. Create a bot via @BotFather → token.
TELEGRAM_BOT_TOKEN=
# Public URL of this worker (for the "connect your Outlook" link sent in chat)
PUBLIC_BASE_URL=http://localhost:8000

# ── Connector — Microsoft Graph (Outlook) ───────────────────────────────────
# Register an app in Entra ID (personal-account/"consumers"); public client is fine.
GRAPH_CLIENT_ID=
GRAPH_AUTHORITY=https://login.microsoftonline.com/consumers
GRAPH_TOKEN_CACHE=.msal_cache.bin
# Optional shared secret if you later wire a Graph change-notification webhook.
WEBHOOK_SECRET=

# ── Deliverability: pace the sends, never spray ─────────────────────────────
SEND_MIN_DELAY_SECONDS=45
SEND_MAX_DELAY_SECONDS=180
DAILY_SEND_CAP=25

# ── Flywheel (later) — skills embedding dimension ───────────────────────────
EMBEDDING_DIM=1024
